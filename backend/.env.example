# ==== Binance Testnet credentials (https://testnet.binance.vision) ====
# Leave empty to run in PAPER mode (simulated wallet, real testnet prices)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# paper = simulated wallet (no keys needed) | live = real orders on Binance SPOT TESTNET
TRADING_MODE=paper

# ==== Bot defaults (seeded on first start, editable in dashboard > Settings) ====
START_BALANCE=10000
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
TIMEFRAME=5m
STRATEGY=sma_cross
STAKE_MODE=fixed
STAKE_AMOUNT=100
STAKE_PERCENT=10
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MAX_OPEN_TRADES=3
POLL_INTERVAL=15

# Optional: protect mutating API endpoints with a token (frontend sends it as X-API-Token)
BOT_API_TOKEN=

# Optional: external Postgres (Neon/Render) instead of local SQLite, e.g. postgresql://user:pass@host/db
DATABASE_URL=

# Where paper mode gets its market data: testnet | mainnet (testnet prices are thin/fake)
PAPER_DATA_SOURCE=testnet
